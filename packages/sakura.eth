  "description": "Нежная тема с мягкими розовыми оттенками",
  "icon": "<svg viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"sakura-plug-grad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\" gradientUnits=\"userSpaceOnUse\" gradientTransform=\"matrix(200,0,0,200,0,100)\"><stop offset=\"0\" stop-color=\"#ff8c80\"/><stop offset=\"1\" stop-color=\"#ffa087\"/></linearGradient></defs><g transform=\"matrix(0,5,-5,0,1000,0)\"><path d=\"M200,61.765L200,138.235C200,172.324 172.324,200 138.235,200L61.765,200C27.676,200 0,172.324 0,138.235L0,61.765C0,27.676 27.676,0 61.765,0L138.235,0C172.324,0 200,27.676 200,61.765Z\" fill=\"url(#sakura-plug-grad)\"/></g><g transform=\"matrix(9.381012,0,0,9.381012,500,500)\"><g transform=\"matrix(1,0,0,1,-41.666667,-41.666667)\"><g transform=\"matrix(4.166667,0,0,4.166667,0,0)\"><path d=\"M12.66,8.76C13.099,7.673 12.296,6.251 11.45,5.354C11.778,4.164 11.821,2.532 10.924,1.779C10.027,1.026 8.427,1.349 7.311,1.877C6.281,1.197 4.743,0.651 3.748,1.271C2.754,1.891 2.568,3.514 2.725,4.738C1.761,5.507 0.766,6.802 1.049,7.939C1.332,9.076 2.817,9.755 4.029,9.983C4.463,11.138 5.387,12.484 6.556,12.567C7.384,12.625 8.176,12.036 8.78,11.304C10,12.824 10.862,14.431 11.335,16.01C10.612,14.93 9.115,14 6,14C6,18.155 9.042,19.003 11,19.003L14.2,19.005C14.2,16.282 13.214,13.095 10.91,10.104C11.693,9.857 12.389,9.427 12.66,8.76M8.283,8.54C7.894,8.782 7.445,8.911 6.987,8.911C5.645,8.911 4.54,7.806 4.54,6.464C4.54,5.62 4.976,4.834 5.692,4.387C6.08,4.145 6.529,4.016 6.987,4.016C8.33,4.016 9.434,5.121 9.434,6.464C9.434,7.307 8.998,8.094 8.282,8.54L8.283,8.54ZM14.02,12.248C15.103,14.418 15.689,16.701 15.698,18.953C18.996,16.582 19,12.206 19,8.003C19,8.003 15.33,9.037 14.02,12.248\" fill=\"#ffffff\" fill-rule=\"nonzero\"/></g></g></g></svg>",
  "css": "/* Ethernet Telegram Theme: Sakura */\n/* @name Sakura */\n/* @description Нежная тема с мягкими розовыми оттенками */\n/* @author Ethernet */\n/* @version 1.0.0 */\n/* @icon <svg viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"_SakuraGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\" gradientUnits=\"userSpaceOnUse\" gradientTransform=\"matrix(200,0,0,200,0,100)\"><stop offset=\"0\" stop-color=\"#ff8c80\"/><stop offset=\"1\" stop-color=\"#ffa087\"/></linearGradient></defs><g transform=\"matrix(0,5,-5,0,1000,0)\"><path d=\"M200,61.765L200,138.235C200,172.324 172.324,200 138.235,200L61.765,200C27.676,200 0,172.324 0,138.235L0,61.765C0,27.676 27.676,0 61.765,0L138.235,0C172.324,0 200,27.676 200,61.765Z\" fill=\"url(#_SakuraGrad)\"/></g><g transform=\"matrix(9.381012,0,0,9.381012,500,500)\"><g transform=\"matrix(1,0,0,1,-41.666667,-41.666667)\"><g transform=\"matrix(4.166667,0,0,4.166667,0,0)\"><path d=\"M12.66,8.76C13.099,7.673 12.296,6.251 11.45,5.354C11.778,4.164 11.821,2.532 10.924,1.779C10.027,1.026 8.427,1.349 7.311,1.877C6.281,1.197 4.743,0.651 3.748,1.271C2.754,1.891 2.568,3.514 2.725,4.738C1.761,5.507 0.766,6.802 1.049,7.939C1.332,9.076 2.817,9.755 4.029,9.983C4.463,11.138 5.387,12.484 6.556,12.567C7.384,12.625 8.176,12.036 8.78,11.304C10,12.824 10.862,14.431 11.335,16.01C10.612,14.93 9.115,14 6,14C6,18.155 9.042,19.003 11,19.003L14.2,19.005C14.2,16.282 13.214,13.095 10.91,10.104C11.693,9.857 12.389,9.427 12.66,8.76M8.283,8.54C7.894,8.782 7.445,8.911 6.987,8.911C5.645,8.911 4.54,7.806 4.54,6.464C4.54,5.62 4.976,4.834 5.692,4.387C6.08,4.145 6.529,4.016 6.987,4.016C8.33,4.016 9.434,5.121 9.434,6.464C9.434,7.307 8.998,8.094 8.282,8.54L8.283,8.54ZM14.02,12.248C15.103,14.418 15.689,16.701 15.698,18.953C18.996,16.582 19,12.206 19,8.003C19,8.003 15.33,9.037 14.02,12.248\" fill=\"#ffffff\" fill-rule=\"nonzero\"/></g></g></g></svg> */\n/* @wallpaper {\"file\":\"data:image/svg+xml;base64,\",\"kind\":\"image\",\"slug\":\"sakura-bg\"} */\n/* @plugins [{\"id\":\"sakura\",\"name\":\"Сакура\",\"enabled\":true}] */\n\n:root {\n  /* Акцентный цвет: мягкий персиково-розовый #ff8c80 */\n  --color-primary: #ff8c80;\n  --color-primary-rgb: 255, 140, 128;\n  --color-primary-shade: color-mix(in srgb, #ff8c80 88%, #2d1f23);\n  --color-primary-shade-darker: color-mix(in srgb, #ff8c80 75%, #2d1f23);\n  --color-primary-shade-rgb: 230, 115, 105;\n  --color-primary-tint: color-mix(in srgb, #ff8c80 14%, transparent);\n  --color-primary-opacity: color-mix(in srgb, #ff8c80 18%, transparent);\n  --color-primary-opacity-hover: color-mix(in srgb, #ff8c80 28%, transparent);\n  --color-active: #ff8c80;\n  --color-active-darker: #e5776d;\n  --accent-color: #ff8c80;\n  --accent-background-color: color-mix(in srgb, #ff8c80 16%, transparent);\n  --accent-background-active-color: color-mix(in srgb, #ff8c80 26%, transparent);\n  --color-interactive-active: #ff8c80;\n\n  /* Теплые пастельные темные тона (не строгий черный!) */\n  --color-background: #241a1e;\n  --color-background-secondary: #2d2026;\n  --color-background-secondary-accent: #3a2931;\n  --color-background-sidebar: #1e1518;\n  --color-background-selected: #48313c;\n  --color-borders: #45303a;\n  --color-dividers: #38262f;\n\n  /* Текст и ссылки */\n  --color-text: #fdefef;\n  --color-links: #ff9e93;\n  --color-text-secondary: #d8b2bb;\n  --color-text-meta-colored: #ffb8b0;\n  --color-send-button: #ff8c80;\n  --color-icon-buttons: #ffdfe3;\n\n  /* Сообщения и чаты */\n  --color-background-own: #522d3a;\n  --color-chat-active: #442a35;\n  --color-chat-hover: rgba(255, 140, 128, 0.08);\n  --color-interactive-hover: rgba(255, 140, 128, 0.09);\n  --color-item-hover: rgba(255, 140, 128, 0.08);\n\n  /* Закругления и стекло */\n  --border-radius-ui: 16px;\n  --border-radius-topbar: 24px;\n  --border-radius-folders-sidebar: 1.125rem;\n  --border-radius-messages: 16px;\n  --border-radius-buttons: 12px;\n  --border-radius-input: 18px;\n  --border-radius-avatars: 50%;\n  --blur-strength: 12px;\n  --blur-glare: 30%;\n  --blur-refraction: 50%;\n  --blur-sidebar: true;\n  --blur-header: true;\n  --blur-bubbles: true;\n  --blur-menus: true;\n  --animation-duration: 260ms;\n  --animation-curve: 0.2, 0.8, 0.2, 1;\n  --chat-width: wide;\n  --message-align-own: right;\n  --message-align-other: left;\n  --profile-open-mode: shift;\n  --media-message-width: standard;\n  --custom-background: url('data:image/svg+xml;base64,') !important;\n}\n\n/* Мягкие розовые акценты элементов */\n.Button.primary,\n.Button.confirm {\n  background: #ff8c80 !important;\n  color: #241a1e !important;\n  font-weight: 600;\n  box-shadow: 0 4px 14px rgba(255, 140, 128, 0.3) !important;\n}\n.Button.primary:hover,\n.Button.confirm:hover {\n  background: #ffa196 !important;\n  box-shadow: 0 6px 18px rgba(255, 140, 128, 0.45) !important;\n}\n\n/* Розовые акцентные бейджи и иконки */\n.badge,\n.unread-count {\n  background-color: #ff8c80 !important;\n  color: #241a1e !important;\n  font-weight: bold;\n}\n\n/* Скроллбары в стиле темы */\n::-webkit-scrollbar-thumb {\n  background: rgba(255, 140, 128, 0.25) !important;\n  border-radius: 8px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(255, 140, 128, 0.45) !important;\n}\n",
  "wallpaper": {
    "file": "data:image/svg+xml;base64,",
    "kind": "image",
    "slug": "sakura-bg"
  },
  "plugins": [
    {
      "id": "sakura",
      "name": "Сакура",
      "version": "1.0.0",
      "author": "Ethernet",
      "description": "Анимация падающих лепестков сакуры",
      "icon": "<svg viewBox=\"0 0 1000 1000\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"sakura-plug-grad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\" gradientUnits=\"userSpaceOnUse\" gradientTransform=\"matrix(200,0,0,200,0,100)\"><stop offset=\"0\" stop-color=\"#ff8c80\"/><stop offset=\"1\" stop-color=\"#ffa087\"/></linearGradient></defs><g transform=\"matrix(0,5,-5,0,1000,0)\"><path d=\"M200,61.765L200,138.235C200,172.324 172.324,200 138.235,200L61.765,200C27.676,200 0,172.324 0,138.235L0,61.765C0,27.676 27.676,0 61.765,0L138.235,0C172.324,0 200,27.676 200,61.765Z\" fill=\"url(#sakura-plug-grad)\"/></g><g transform=\"matrix(9.381012,0,0,9.381012,500,500)\"><g transform=\"matrix(1,0,0,1,-41.666667,-41.666667)\"><g transform=\"matrix(4.166667,0,0,4.166667,0,0)\"><path d=\"M12.66,8.76C13.099,7.673 12.296,6.251 11.45,5.354C11.778,4.164 11.821,2.532 10.924,1.779C10.027,1.026 8.427,1.349 7.311,1.877C6.281,1.197 4.743,0.651 3.748,1.271C2.754,1.891 2.568,3.514 2.725,4.738C1.761,5.507 0.766,6.802 1.049,7.939C1.332,9.076 2.817,9.755 4.029,9.983C4.463,11.138 5.387,12.484 6.556,12.567C7.384,12.625 8.176,12.036 8.78,11.304C10,12.824 10.862,14.431 11.335,16.01C10.612,14.93 9.115,14 6,14C6,18.155 9.042,19.003 11,19.003L14.2,19.005C14.2,16.282 13.214,13.095 10.91,10.104C11.693,9.857 12.389,9.427 12.66,8.76M8.283,8.54C7.894,8.782 7.445,8.911 6.987,8.911C5.645,8.911 4.54,7.806 4.54,6.464C4.54,5.62 4.976,4.834 5.692,4.387C6.08,4.145 6.529,4.016 6.987,4.016C8.33,4.016 9.434,5.121 9.434,6.464C9.434,7.307 8.998,8.094 8.282,8.54L8.283,8.54ZM14.02,12.248C15.103,14.418 15.689,16.701 15.698,18.953C18.996,16.582 19,12.206 19,8.003C19,8.003 15.33,9.037 14.02,12.248\" fill=\"#ffffff\" fill-rule=\"nonzero\"/></g></g></g></svg>",
      "permissions": [
        "dom.style",
        "storage.local"
      ],
      "code": "/**\n * Plugin: Sakura (Сакура)\n * @name Сакура\n * @description Анимация падающих лепестков сакуры\n * @author Ethernet\n * @version 1.0.0\n * @permissions dom.style, storage.local\n */\n\n(function () {\n  'use strict';\n\n  const PLUGIN_ID = 'sakura';\n  const CANVAS_ID = 'ethernet-sakura-canvas';\n  const STYLE_ID = 'ethernet-sakura-styles';\n\n  const CSS = `\n    #${CANVAS_ID} {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100vw;\n      height: 100vh;\n      pointer-events: none;\n      z-index: 99990;\n      display: block;\n    }\n  `;\n\n  // SVG-путь цветка сакуры из sakura-flower.svg (viewBox 0 0 64 64)\n  const FLOWER_PATH_DATA = 'M58.1 32.2c3.1-2.8 3.8-5.8 3.9-7.8c0-.5-.2-1-.6-1.3s-.9-.4-1.4-.3c-1 .2-2.2-.3-2.6-1.3c-.5-1.1-.2-2.3.6-3.1c.4-.3.6-.8.6-1.3s-.2-.9-.6-1.2c-1-.8-2.1-1.3-3.4-1.6c.1-1.8-.3-3.5-1.1-5c-.2-.4-.7-.8-1.2-.9s-1 .1-1.4.4c-.8.7-2 .8-2.9.2s-1.3-1.9-.9-2.9c.2-.5.1-1-.1-1.4c-.3-.4-.7-.7-1.2-.7c-2-.3-4 .2-6 1.2c-.9-1.2-2-2.2-3.3-2.9c-.4-.2-1-.3-1.4-.1c-.5.2-.8.6-.9 1.1c-.2 1.1-1.1 1.8-2.2 1.8s-2-.8-2.3-1.9c-.1-.5-.5-.9-.9-1.1c-.5-.2-1-.2-1.4.1c-1.3.7-2.4 1.7-3.3 2.9c-1.9-1.1-3.9-1.5-5.9-1.2c-.5.1-.9.3-1.2.8c-.3.3-.4.9-.2 1.3c.4 1.1 0 2.3-.9 2.9c-.8.6-2.1.5-2.9-.2c-.4-.3-.9-.5-1.4-.4q-.75.15-1.2.9c-.8 1.5-1.1 3.2-1.1 5c-1.1.4-2.3.9-3.3 1.7q-.6.45-.6 1.2c0 .75.2.9.6 1.3c.9.7 1.1 2 .6 3.1c-.4.9-1.6 1.5-2.6 1.2c-.5-.1-1 0-1.4.3c-.4.4-.6.9-.6 1.4c.1 2 .8 5 3.9 7.8C2.8 35 2.1 37.9 2 39.9c0 .5.2 1 .6 1.3s.9.4 1.4.3c1-.2 2.2.3 2.6 1.3c.5 1 .2 2.3-.6 3c-.4.3-.6.8-.6 1.3s.2.9.6 1.2c1 .7 2.1 1.3 3.4 1.6c-.2 2 .2 3.8 1 5.5c.2.5.7.8 1.2.9s1-.1 1.4-.4c.8-.7 2-.8 2.9-.2c.9.7 1.3 1.9.9 3c-.2.5-.1 1 .1 1.4c.3.4.7.7 1.2.8c.4 0 .8.1 1.1.1c1.7 0 3.5-.5 5.2-1.5c.8 1 1.8 1.8 2.9 2.4c.4.2 1 .3 1.4.1c.5-.2.8-.6.9-1.1c.3-1.1 1.2-1.9 2.3-1.9s2 .8 2.3 1.9c.1.5.5.9.9 1.1c.2.1.4.1.7.1s.5-.1.8-.2c1.1-.6 2.1-1.4 2.9-2.4c1.7 1 3.4 1.5 5.2 1.5c.4 0 .8 0 1.1-.1c.5-.1.9-.3 1.2-.8c.3-.4.3-.9.1-1.4c-.4-1.1 0-2.3.9-3c.8-.6 2.1-.5 2.9.2c.4.3.9.5 1.4.4q.75-.15 1.2-.9c.8-1.7 1.2-3.5 1-5.5c1.3-.3 2.4-.8 3.4-1.6q.6-.45.6-1.2c0-.75-.2-.9-.6-1.3c-.9-.7-1.1-2-.6-3s1.6-1.5 2.6-1.3h.4c.4 0 .7-.1 1-.4c.4-.3.6-.8.6-1.3c0-1.9-.7-4.8-3.8-7.6M43.8 7.1c0 1.8.9 3.4 2.4 4.5c1.5 1 3.3 1.3 5 .7c.1.5.1 1.1.1 1.7c-2.3.1-4.7.8-7.3 2.1c-.5.3-1.1.6-1.6 1c.1-.7.1-1.3.1-2c0-2.7-.4-5.1-1.1-7.1q1.2-.75 2.4-.9m-31 5.2c1.6.5 3.6.3 5-.7c1.5-1 2.4-2.7 2.4-4.5q1.2.15 2.4.9c-.7 2-1.1 4.4-1.1 7.1c0 .6 0 1.3.1 2c-.5-.4-1.1-.7-1.6-1c-2.6-1.3-5-2-7.3-2.1c0-.6 0-1.2.1-1.7';\n\n  // SVG-путь отдельного нежного лепестка\n  const PETAL_PATH_DATA = 'M 0 -16 C 9 -12, 13 4, 6 15 C 0 18, -6 15, -13 4 C -9 -12, 0 -16, 0 -16 Z';\n\n  let flowerPath2D = null;\n  let petalPath2D = null;\n\n  try {\n    if (typeof Path2D !== 'undefined') {\n      flowerPath2D = new Path2D(FLOWER_PATH_DATA);\n      petalPath2D = new Path2D(PETAL_PATH_DATA);\n    }\n  } catch (e) {\n    console.warn('[sakura] Path2D not available', e);\n  }\n\n  // Нежная палитра лепестков сакуры\n  const SAKURA_COLORS = [\n    '#ff8c80',\n    '#ffa89e',\n    '#ff9587',\n    '#ffb3aa',\n    '#ff796c',\n    '#ffd0ca',\n  ];\n\n  let canvas = null;\n  let ctx = null;\n  let animationFrameId = null;\n  let particles = [];\n  let isRunning = false;\n  let mouse = { x: -1000, y: -1000, vx: 0, vy: 0, lastX: 0, lastY: 0 };\n\n  const PARTICLE_COUNT = 36; // Сбалансированное количество лепестков без просадки FPS\n\n  class SakuraParticle {\n    constructor(isInitial = false) {\n      this.reset(isInitial);\n    }\n\n    reset(isInitial = false) {\n      const w = window.innerWidth || document.documentElement.clientWidth || 1920;\n      const h = window.innerHeight || document.documentElement.clientHeight || 1080;\n\n      this.isFlower = Math.random() < 0.28; // 28% цветков, 72% отдельных лепестков\n      this.x = Math.random() * (w + 100) - 50;\n      this.y = isInitial ? Math.random() * h : -30 - Math.random() * 50;\n\n      this.size = this.isFlower\n        ? (14 + Math.random() * 12) // Размер цветка\n        : (10 + Math.random() * 8);  // Размер лепестка\n\n      this.speedY = 0.8 + Math.random() * 1.4;\n      this.speedX = 0.3 + Math.random() * 0.8; // Легкий дрейф вправо\n      this.swayAngle = Math.random() * Math.PI * 2;\n      this.swaySpeed = 0.015 + Math.random() * 0.025;\n      this.swayRadius = 0.8 + Math.random() * 1.5;\n\n      this.rotation = Math.random() * Math.PI * 2;\n      this.rotationSpeed = (Math.random() - 0.5) * 0.03;\n\n      this.flutterAngle = Math.random() * Math.PI * 2;\n      this.flutterSpeed = 0.02 + Math.random() * 0.04;\n\n      this.color = SAKURA_COLORS[Math.floor(Math.random() * SAKURA_COLORS.length)];\n      this.opacity = 0.65 + Math.random() * 0.32;\n\n      // Дополнительный импульс от мыши\n      this.pushVx = 0;\n      this.pushVy = 0;\n    }\n\n    update(w, h) {\n      this.swayAngle += this.swaySpeed;\n      this.flutterAngle += this.flutterSpeed;\n      this.rotation += this.rotationSpeed;\n\n      // Взаимодействие с ветерком от курсора\n      const dx = this.x - mouse.x;\n      const dy = this.y - mouse.y;\n      const dist = Math.hypot(dx, dy);\n      if (dist < 130 && dist > 1) {\n        const force = (1 - dist / 130) * 1.8;\n        this.pushVx += (dx / dist) * force + mouse.vx * 0.2;\n        this.pushVy += (dy / dist) * force + mouse.vy * 0.2;\n      }\n\n      this.pushVx *= 0.94;\n      this.pushVy *= 0.94;\n\n      this.x += this.speedX + Math.sin(this.swayAngle) * this.swayRadius + this.pushVx;\n      this.y += this.speedY + this.pushVy;\n\n      // Если лепесток улетел за границы — возрождаем сверху\n      if (this.y > h + 40 || this.x > w + 60 || this.x < -60) {\n        this.reset(false);\n      }\n    }\n\n    draw(context) {\n      context.save();\n      context.translate(this.x, this.y);\n      context.rotate(this.rotation);\n\n      // Эффект 3D-порхания в воздухе за счет сжатия по Y\n      const flutterScale = Math.cos(this.flutterAngle);\n      context.scale(1, flutterScale);\n\n      context.globalAlpha = this.opacity;\n      context.fillStyle = this.color;\n\n      if (this.isFlower && flowerPath2D) {\n        // Масштабируем SVG из 64x64\n        const s = this.size / 64;\n        context.scale(s, s);\n        context.translate(-32, -32);\n        context.fill(flowerPath2D);\n      } else if (petalPath2D) {\n        const s = this.size / 24;\n        context.scale(s, s);\n        context.fill(petalPath2D);\n      } else {\n        // Fallback простая форма лепестка\n        context.beginPath();\n        context.ellipse(0, 0, this.size * 0.6, this.size, 0, 0, Math.PI * 2);\n        context.fill();\n      }\n\n      context.restore();\n    }\n  }\n\n  function resizeCanvas() {\n    if (!canvas) return;\n    const dpr = Math.min(window.devicePixelRatio || 1, 2);\n    const w = window.innerWidth || document.documentElement.clientWidth || 1920;\n    const h = window.innerHeight || document.documentElement.clientHeight || 1080;\n    canvas.width = Math.round(w * dpr);\n    canvas.height = Math.round(h * dpr);\n    canvas.style.width = `${w}px`;\n    canvas.style.height = `${h}px`;\n    if (ctx) {\n      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    }\n  }\n\n  function loop() {\n    if (!isRunning || !ctx || !canvas) return;\n\n    const w = window.innerWidth || document.documentElement.clientWidth || 1920;\n    const h = window.innerHeight || document.documentElement.clientHeight || 1080;\n\n    ctx.clearRect(0, 0, w, h);\n\n    // Затухание скорости мыши\n    mouse.vx *= 0.8;\n    mouse.vy *= 0.8;\n\n    for (let i = 0; i < particles.length; i++) {\n      const p = particles[i];\n      p.update(w, h);\n      p.draw(ctx);\n    }\n\n    animationFrameId = requestAnimationFrame(loop);\n  }\n\n  function onMouseMove(e) {\n    mouse.vx = (e.clientX - mouse.lastX) * 0.15;\n    mouse.vy = (e.clientY - mouse.lastY) * 0.15;\n    mouse.lastX = e.clientX;\n    mouse.lastY = e.clientY;\n    mouse.x = e.clientX;\n    mouse.y = e.clientY;\n  }\n\n  function onVisibilityChange() {\n    if (document.hidden) {\n      if (animationFrameId) {\n        cancelAnimationFrame(animationFrameId);\n        animationFrameId = null;\n      }\n    } else if (isRunning && !animationFrameId) {\n      animationFrameId = requestAnimationFrame(loop);\n    }\n  }\n\n  function init() {\n    // 1. Добавляем стили\n    let style = document.getElementById(STYLE_ID);\n    if (!style) {\n      style = document.createElement('style');\n      style.id = STYLE_ID;\n      style.textContent = CSS;\n      document.head.appendChild(style);\n    }\n\n    // 2. Создаем канвас\n    canvas = document.getElementById(CANVAS_ID);\n    if (!canvas) {\n      canvas = document.createElement('canvas');\n      canvas.id = CANVAS_ID;\n      document.body.appendChild(canvas);\n    }\n\n    ctx = canvas.getContext('2d');\n    resizeCanvas();\n\n    // 3. Создаем лепестки\n    particles = [];\n    for (let i = 0; i < PARTICLE_COUNT; i++) {\n      particles.push(new SakuraParticle(true));\n    }\n\n    window.addEventListener('resize', resizeCanvas);\n    window.addEventListener('mousemove', onMouseMove, { passive: true });\n    document.addEventListener('visibilitychange', onVisibilityChange);\n\n    isRunning = true;\n    animationFrameId = requestAnimationFrame(loop);\n\n    console.log('[sakura] Plugin initialized: falling petals active');\n  }\n\n  function destroy() {\n    isRunning = false;\n    if (animationFrameId) {\n      cancelAnimationFrame(animationFrameId);\n      animationFrameId = null;\n    }\n    window.removeEventListener('resize', resizeCanvas);\n    window.removeEventListener('mousemove', onMouseMove);\n    document.removeEventListener('visibilitychange', onVisibilityChange);\n\n    if (canvas && canvas.parentNode) {\n      canvas.parentNode.removeChild(canvas);\n      canvas = null;\n    }\n    const style = document.getElementById(STYLE_ID);\n    if (style && style.parentNode) {\n      style.parentNode.removeChild(style);\n    }\n    particles = [];\n    console.log('[sakura] Plugin unloaded');\n  }\n\n  // Запуск при готовности DOM\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n\n  // Регистрация teardown через onDestroy\n  if (typeof ethernet !== 'undefined' && ethernet.onDestroy) {\n    ethernet.onDestroy(destroy);\n  } else if (typeof window !== 'undefined' && window.ethernet && window.ethernet.onDestroy) {\n    window.ethernet.onDestroy(destroy);\n  }\n})();\n"
    }
  ]
}